# Templates only. Fill these in a local, ignored .env.local after services are chosen.
DATABASE_URL=
# Vercel Production only: a production-restricted PostgreSQL credential.
PRODUCTION_DATABASE_URL=
# Vercel Preview only: a different, preview-restricted PostgreSQL credential.
PREVIEW_DATABASE_URL=
# Optional outside Vercel: crunchify_private or crunchify_preview. Vercel Preview
# selects crunchify_preview automatically; production uses crunchify_private.
DATABASE_SCHEMA=
BREVO_API_KEY=
MAIL_FROM=
INQUIRY_NOTIFICATION_TO=
ADMIN_USER=
# Generate with npm run admin:generate; do not place the raw password here.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
